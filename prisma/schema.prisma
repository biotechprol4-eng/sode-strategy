generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationStatus { ACTIVE SUSPENDED ARCHIVED }
enum MemberRole { CENTRAL PERIPHERAL }
enum MemberStatus { ACTIVE BLOCKED ARCHIVED }
enum OtpPurpose { RECOVERY MFA CRITICAL_OPERATION EMAIL_VERIFICATION }
enum OtpStatus { PENDING VERIFIED EXPIRED REVOKED }
enum AuditStatus { SUCCESS FAILURE }
enum CreditTransactionType { PURCHASE USAGE REFUND TRIAL_GRANT }

model Organization {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  slug           String            @unique
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  members        Member[]
  roles          Role[]
  sessions       Session[]
  otpChallenges  OtpChallenge[]
  auditEvents    AuditEvent[]
  creditAccount  CreditAccount?
  creditTxns     CreditTransaction[]
  passwordResets PasswordReset[]

  @@map("organizations")
}

model Member {
  id            String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  sodeKey       String          @unique @map("sode_key") @db.VarChar(40)
  email         String          @db.VarChar(320)
  fullName      String          @map("full_name")
  role          MemberRole      @default(PERIPHERAL)
  status        MemberStatus    @default(ACTIVE)
  emailVerified Boolean         @default(false) @map("email_verified")
  lastLoginAt   DateTime?       @map("last_login_at")
  blockedAt     DateTime?       @map("blocked_at")
  archivedAt    DateTime?       @map("archived_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  organization    Organization      @relation(fields: [organizationId], references: [id])
  credential      Credential?
  sessions        Session[]
  otpChallenges   OtpChallenge[]
  memberRoles     MemberRoleLink[]
  auditEvents     AuditEvent[]
  passwordResets  PasswordReset[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("members")
}

model Credential {
  id           String   @id @default(uuid()) @db.Uuid
  memberId     String   @unique @map("member_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Role {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization    Organization      @relation(fields: [organizationId], references: [id])
  memberRoles     MemberRoleLink[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id              String          @id @default(uuid()) @db.Uuid
  resource        String
  action          String
  createdAt       DateTime        @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model MemberRoleLink {
  memberId   String   @map("member_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  memberId         String      @map("member_id") @db.Uuid
  refreshTokenHash String      @unique @map("refresh_token_hash")
  ipAddress        String?     @map("ip_address")
  userAgent        String?     @map("user_agent")
  expiresAt        DateTime    @map("expires_at")
  revokedAt        DateTime?   @map("revoked_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([organizationId])
  @@map("sessions")
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  purpose     OtpPurpose
  status      OtpStatus @default(PENDING)
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([organizationId, expiresAt])
  @@map("otp_challenges")
}

model PasswordReset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  otpId          String   @map("otp_id") @db.Uuid
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("password_resets")
}

model AuditEvent {
  id           String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId      String?     @map("actor_id") @db.Uuid
  action       String
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id") @db.Uuid
  status       AuditStatus
  details      Json?
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Member?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model CreditAccount {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  balance        Decimal   @default(0) @db.Decimal(18, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("credit_accounts")
}

model CreditTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  amount         Decimal               @db.Decimal(18, 2)
  type           CreditTransactionType
  description    String?
  referenceId    String?               @map("reference_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("credit_transactions")
}
